# PostgreSQL Database Connection
# Replace with your PostgreSQL connection string (e.g., Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/nj_select_deals?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/nj_select_deals"

# Authentication / Session Security (Must be at least 32 characters in production)
JWT_SECRET="generate_a_secure_random_string_at_least_32_chars"

# Initial Admin Setup Credentials
# Used ONLY by explicit CLI seed command: `npm run db:seed`
ADMIN_EMAIL="admin@njselectdeals.com"
ADMIN_PASSWORD="ReplaceWithStrongPassword123!"
ADMIN_NAME="Store Administrator"

# Public Store Settings
NEXT_PUBLIC_STORE_NAME="NJ Select Deals"
NEXT_PUBLIC_STORE_EMAIL="support@njselectdeals.com"
NEXT_PUBLIC_STORE_PHONE="(800) 555-DEAL"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="50"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_live_or_test_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_or_test_key"
STRIPE_WEBHOOK_SECRET="whsec_signing_secret"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Transactional Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="NJ Select Deals <orders@yourdomain.com>"

# Supabase Storage Configuration (for product image uploads)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"


