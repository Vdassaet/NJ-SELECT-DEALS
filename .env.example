# PostgreSQL Database Connection
# Replace with your PostgreSQL connection string (e.g., Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nj_select_deals?schema=public"

# Authentication / Session Security
JWT_SECRET="change_this_to_a_secure_random_string_at_least_32_characters_long"

# Initial Admin Setup Credentials
# Used by `npm run db:seed` to create the initial store owner account securely
ADMIN_EMAIL="admin@njselectdeals.com"
ADMIN_PASSWORD="AdminSecurePassword2026!"
ADMIN_NAME="Store Administrator"

# Public Store Settings
NEXT_PUBLIC_STORE_NAME="NJ Select Deals"
NEXT_PUBLIC_STORE_EMAIL="support@njselectdeals.com"
NEXT_PUBLIC_STORE_PHONE="(800) 555-DEAL"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="50"

# Stripe Payment Gateway
# Obtain your API keys from the Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret from `stripe listen` or Stripe Dashboard webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Transactional Email (Resend)
# Obtain your API key from Resend: https://resend.com
RESEND_API_KEY="re_..."
EMAIL_FROM="NJ Select Deals <orders@yourdomain.com>"


